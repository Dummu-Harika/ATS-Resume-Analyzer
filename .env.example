# Example environment variables for local development
# NOTE: Do NOT commit real secrets. Copy this to .env and fill values.

# Shared service ports
PORT=8002
QUIZ_PORT=8003
APP_ENV=development

# Frontend
VITE_API_URL=http://localhost:8002
VITE_INTERVIEW_URL=http://localhost:5173

# Resume Screener backend
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
ALLOWED_ORIGINS=http://localhost:3000
QUIZ_API_URL=http://localhost:8003
INTERVIEW_API_URL=http://localhost:8004
INTERVIEW_PORT=8004
MOCK_AI=true

# Security/Authentication
# Generate secure random values for production and set them in the environment (do NOT commit secrets)
RECRUITER_API_KEY=
AGGREGATOR_WEBHOOK_SECRET=
ENVIRONMENT=development


# Aggregation weights (sum must equal 1.0)
# Defaults: ROUND1_WEIGHT=0.40, ROUND2_WEIGHT=0.30, ROUND3_WEIGHT=0.30
ROUND1_WEIGHT=0.40
ROUND2_WEIGHT=0.30
ROUND3_WEIGHT=0.30

# Quiz backend
# Set APP_ENV=production and provide a real GEMINI_API_KEY for production.
# MOCK_AI=false
